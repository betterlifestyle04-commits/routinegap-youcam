# Use a server-only environment variable; never put the secret in public/app.js.
YOUCAM_API_KEY=
# Enable only when YOUCAM_API_KEY and DEMO_ACCESS_TOKEN are configured.
LIVE_SCANS_ENABLED=false
# Choose a long, random secret. Provide it privately to hackathon judges in Devpost testing instructions.
DEMO_ACCESS_TOKEN=
# Optional deployment settings; the service listens on 0.0.0.0.
PORT=3000
# Optional: set exact public domain to reject cross-site POSTs.
PUBLIC_ORIGIN=
