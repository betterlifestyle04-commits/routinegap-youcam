# Use a server-only environment variable; never put the secret in public/app.js.
YOUCAM_API_KEY=
# Enable only when YOUCAM_API_KEY and the server-only task-receipt signing secret are configured.
LIVE_SCANS_ENABLED=false
# Long random server-only signing secret; also usable as private owner access code.
DEMO_ACCESS_TOKEN=
# Optional deployment settings; the service listens on 0.0.0.0.
PORT=3000
# Optional: set exact public domain to reject cross-site POSTs.
PUBLIC_ORIGIN=

# OPTIONAL: allow a tiny public judge scan quota without entering the owner passcode.
# Server defaults to OFF; max 3 public starts daily (one per visitor/day).
# Quotas reset after deployment/restart; separately enforce spending caps in YouCam.
PUBLIC_JUDGE_SCANS_ENABLED=false
